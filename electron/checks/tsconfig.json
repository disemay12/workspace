{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "node16",
    "outDir": "../../dist-electron",
    // Проверочные скрипты импортируют код из src/ (formulaEngine, dateFormat),
    // поэтому корнем компиляции служит каталог проекта, а не electron/checks.
    "rootDir": "../..",
    "strict": false,
    "noImplicitAny": false,
    "noImplicitThis": false,
    "strictNullChecks": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmitOnError": false,
    "types": ["node"],
    "forceConsistentCasingInFileNames": true
  },
  "include": ["./**/*.ts"]
}

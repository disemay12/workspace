{
  "name": "workspace",
  "version": "1.0.13",
  "description": "WorkSpace",
  "main": "dist-electron/main.js",
  "author": "WorkSpace",
  "license": "ISC",
  "type": "commonjs",
  "scripts": {
    "dev": "concurrently -k -n VITE,ELECTRON -c cyan,magenta \"npm:dev:vite\" \"npm:dev:electron:wait\"",
    "dev:vite": "vite",
    "dev:electron:wait": "wait-on --timeout 30000 tcp:127.0.0.1:5173 && npm run dev:electron",
    "dev:electron": "npm run build:electron && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 node scripts/run-electron.js dist-electron/main.js",
    "build": "npm run build:vite && npm run build:electron",
    "prebuild": "npm run icon",
    "build:vite": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "start": "npm run build && node scripts/run-electron.js dist-electron/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "icon": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/make-icon.ps1",
    "checks:build": "tsc -p electron/checks/tsconfig.json",
    "checks:sync": "node scripts/sync-checks.js",
    "checks": "npm run checks:build && npm run checks:sync && node dist-electron/run-all-checks.js",
    "pack": "npm run build && electron-builder --win --x64 --dir",
    "dist": "npm run build && electron-builder --win --x64",
    "build:portable": "node scripts/build-portable.js",
    "pack:release": "node scripts/pack-release.js"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@types/katex": "^0.16.8",
    "@types/prismjs": "^1.26.6",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "clsx": "^2.1.1",
    "iconv-lite": "^0.7.3",
    "jszip": "^3.10.2",
    "katex": "^0.19.0",
    "lucide-react": "^1.56.0",
    "mammoth": "^1.13.0",
    "marked": "^18.1.1",
    "mermaid": "^12.2.0",
    "prismjs": "^1.30.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^44.7.1",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.30",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "wait-on": "^9.5.1"
  }
}
